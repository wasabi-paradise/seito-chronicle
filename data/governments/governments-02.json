  "partiesCheck": {
   "on": "2026-11-21",
   "text": "自民党・公明党の連立。2025年10月10日に公明党が連立を離脱（公明新聞）"
  },
  "events": [
   {
    "title": "公明党の連立離脱（2025年10月）",
    "summary": {
     "text": "2025年9月7日、石破首相が自民党総裁を辞任すると表明した。10月4日に高市早苗氏が総裁に選ばれ公明党と連立協議を始めたが、10月10日、「政治とカネ」の問題への対応をめぐって公明党が連立離脱を伝えた。自民党は10月20日に日本維新の会と連立政権合意を結び、21日に高市内閣が発足した。",
     "sources": [
      "kantei20250907",
      "jimin20251021",
      "komei20251011",
      "renritsu2025",
      "k104"
     ]
    },
    "facts": [
     {
      "date": "2025-09-07",
      "text": "石破首相が記者会見で自民党総裁の職を辞すると表明。",
      "sources": [
       "kantei20250907"
      ]
     },
     {
      "date": "2025-10-04",
      "text": "自民党総裁に高市早苗氏が選ばれ、公明党との連立協議を始める。",
      "sources": [
       "jimin20251021",
       "komei20251011"
      ]
     },
     {
      "date": "2025-10-10",
      "text": "自民・公明の党首会談で、公明党が連立政権からの離脱を伝える。",
      "sources": [
       "jimin20251010",
       "komei20251011"
      ]
     },
     {
      "date": "2025-10-20",
      "text": "自民党と日本維新の会が連立政権合意書を交わし、21日に高市内閣が発足（維新は当初、閣僚を出さない閣外協力）。",
      "sources": [
       "renritsu2025",
       "k104",
       "kokkai20251126"
      ]
     }
    ],
    "sides": [
     {
      "who": "離脱した公明党",
      "text": "党の機関紙で、自民党に求めていた「政治とカネ」を巡る問題への対応について「明確かつ具体的な協力が得られなかったため、自公連立政権はいったん白紙として、これまでの関係に区切りを付けることを決めました」と説明。企業・団体献金の受け手を党本部と都道府県組織に絞る規制強化を求めたが、自民党の回答は「これから検討する」というものだったとしている。",
      "sources": [
       "komei20251011",
       "komei20251010"
      ]
     },
     {
      "who": "自民党（高市総裁）",
      "text": "党の発表によれば、高市総裁は「公明党から政治資金規正法改正の公明党案についてその場で賛否を示すよう求められた。わが党での手続きを経ずにこの場で総裁、幹事長が決めることはできないと説明した」と述べた。会見では「先方からは、『それは、具体的な回答ではない』ということで、一方的に連立政権からの離脱を伝えられました」と述べている。",
      "sources": [
       "jimin20251010b",
       "jimin20251010"
      ]
     },
     {
      "who": "石破首相（退陣の理由）",
      "text": "退陣を表明した会見で「選挙結果に対する責任は総裁たる私にある」と述べ、「米国関税措置に関する交渉に一つの区切りがついた今こそが、その「然るべきタイミング」であると、このように考え、後進に道を譲る決断をいたしました」と説明した。",
      "sources": [
       "kantei20250907"
      ]
     }
    ],
    "background": [],
    "note": ""
   }
  ]
 },
