   "events": [
    {
     "title": "宮澤内閣不信任決議案の可決から、非自民の連立政権へ（1993年）",
     "summary": {
      "text": "1993年6月18日、政治改革法案の扱いをめぐって野党が提出した宮澤内閣不信任決議案が、自民党羽田派などの賛成で可決された。宮澤首相は衆議院を解散し、7月の総選挙で自民党は過半数に届かなかった。8月9日、非自民の8党派による細川内閣が発足した。",
      "sources": [
       "habara2007",
       "kokkai19930618c",
       "jh15",
       "k79"
      ]
     },
     "facts": [
      {
       "date": "1993-06-18",
       "text": "衆議院で宮澤内閣不信任決議案が可決（投票総数475、賛成255、反対220）。賛成者の名簿には羽田孜・小沢一郎の各議員が、反対者の名簿には武村正義・鳩山由紀夫の各議員が載っている。",
       "sources": [
        "kokkai19930618c",
        "habara2007"
       ]
      },
      {
       "date": "1993-06-18",
       "text": "宮澤首相が衆議院を解散。同日夜、武村正義氏らが自民党を離党し、新党さきがけの結党を表明（6月21日結党）。",
       "sources": [
        "jh15",
        "shimizu2014"
       ]
      },
      {
       "date": "1993-07-18",
       "text": "総選挙で自民党は過半数に届かず、その後、宮澤首相が退陣を表明。",
       "sources": [
        "jh15"
       ]
      },
      {
       "date": "1993-08-09",
       "text": "非自民の8党派による細川内閣が発足。自民党は結党以来初めて野党となった。",
       "sources": [
        "k79",
        "ndl_ref2014",
        "jh15"
       ]
      }
     ],
     "sides": [
      {
       "who": "不信任案を提出した野党（社会党など）",
       "text": "提出理由の説明で「不信任の第一の理由は、本院の政治改革等特別委員会における百七時間を費やした審議とその経過を無視し、政治改革の実現を放棄したことにあります。」「第二の理由は、国民と国会への公約をほごにした責任です。」と述べた（山花貞夫議員、1993年6月18日）。",
       "sources": [
        "kokkai19930618a"
       ]
      },
      {
       "who": "賛成に回った自民党の羽田派など",
       "text": "論文によれば、採決では「各野党と自民党羽田派 34、他派閥 5 が賛成、16 人が欠席」した。羽田孜氏は、約1年後の首相在任中（1994年5月）の国会で、自民党を離れた理由について「私は自民党を離党するときは、別に利を求めたのじゃありません。」「今ここで行動しないと全体がもう閉塞状況に陥ってしまうという中で飛び出た人間です。」と述べている。",
       "sources": [
        "habara2007",
        "kokkai19940531",
        "kokkai19940527"
       ]
      },
      {
       "who": "反対した自民党",
       "text": "反対討論で、不信任案は「政治改革のともしびを消すばかりでなく、」「国政の停滞をもたらし、国民生活に決して利益をもたらさない」と述べた（関谷勝嗣議員、1993年6月18日）。",
       "sources": [
        "kokkai19930618b"
       ]
      },
      {
       "who": "宮澤首相",
       "text": "解散の理由を首相本人が述べた記録は、国会会議録では確認できなかった。自民党の党史は、宮澤首相が「党内情勢を考慮し、通常国会の閉幕が近づいた六月中旬、政治改革法案の成立を次期国会に先送りする意向を固めます」と記している。",
       "sources": [
        "jh15"
       ]
      },
      {
       "who": "新党さきがけ（武村正義氏ら）",
       "text": "採決では武村氏は反対票を投じ、同日夜に離党した（会議録の採決記録・年表）。離党の理由を本人が述べた記録は、国会会議録では確認できなかった。",
       "sources": [
        "kokkai19930618c",
        "shimizu2014"
       ]
      },
      {
       "who": "新しく政権を担った側（細川首相）",
       "text": "所信表明演説で、総選挙で示された「政治改革実現のための千載一遇のチャンスを逃すことなく、「本年中に政治改革を断行する」」とし、外交・防衛などの基本政策は「原則として今までの国の政策を継承することを確認いたしました」と述べた（1993年8月23日）。",
       "sources": [
        "kokkai19930823"
       ]
      }
     ],
     "background": [],
     "note": "自民党の党史は武村氏のグループも不信任案に賛成票を投じたと記しているが、会議録の採決記録では武村正義氏は反対（否）の名簿に載っている。"
    }
   ]
